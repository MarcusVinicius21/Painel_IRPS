# Documentation template only. The application reads explicit IRPS_LOCAL_CONFIG,
# never auto-loads existing .env files, OpenAI keys or Google credentials.
IRPS_LOCAL_CONFIG=ABSOLUTE_PATH_TO_PROJECT/.runtime/config-local.json
IRPS_AI_ENABLED=false
# For future deployment: provision PostgreSQL roles and an HTTPS OIDC issuer/JWKS.
# DATABASE_URL=postgresql+psycopg://APP_ROLE:REPLACE_OUTSIDE_GIT@HOST/IRPS_DATABASE
# OIDC_ISSUER=https://IDENTITY_PROVIDER/REALM
# OIDC_AUDIENCE=IRPS_AUDIENCE
# OIDC_JWKS_URL=https://IDENTITY_PROVIDER/REALM/JWKS
# Cookie Secure must be true with HTTPS outside loopback tests.
