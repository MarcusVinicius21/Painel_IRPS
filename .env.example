# Documentation template only; this file is not loaded automatically.
# Prepare private JSON configuration inside .runtime using scripts/preparar_ambiente.ps1.
# Never commit that JSON, passwords, authenticated DSNs, sessions or signing keys.
IRPS_LOCAL_CONFIG=ABSOLUTE_PATH_TO_PROJECT/.runtime/config-local.json
IRPS_AI_ENABLED=false
# For a future deployment, provision secrets outside this repository.
# Intentionally empty: no username/password URI belongs in this template.
DATABASE_URL=
OWNER_DATABASE_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Cookie Secure must be true with HTTPS outside loopback tests.
